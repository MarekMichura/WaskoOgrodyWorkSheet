{
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**.sln": true,
    "**/bin": true,
    "**/obj": true,
    "next-env.d.ts": true,
    "yarn.lock": true,
    "node_modules": true,
    "build": true
  },
  "hide-files.files": ["next-env.d.ts", "yarn.lock", "node_modules", "build"],
  "stylelint.validate": ["scss", "css"],
  "cSpell.words": ["GSAP", "Nuqs", "Plaiceholder", "Pychowicka", "turbopack", "Tweens"],
  "editor.codeActionsOnSave": {
    "source.fixAll.stylelint": "always"
  },
  "todohighlight.keywords": [
    {
      "text": "SECT:",
      "isWholeLine": true,
      "backgroundColor": "#28242c"
    }
  ]
}
