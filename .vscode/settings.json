{
  "cSpell.words": [
    "GSAP",
    "Nuqs",
    "Plaiceholder",
    "Pychowicka",
    "turbopack",
    "Tweens",
    "Antiforgery",
    "Archivo",
    "ASPNETCORE",
    "beforeinstallprompt",
    "brotli",
    "csscomb",
    "Dima",
    "Eurovia",
    "fullscreen",
    "gifsicle",
    "Henniger",
    "Hsts",
    "jpegtran",
    "keyval",
    "klimanowa",
    "lottiefiles",
    "Narama",
    "optipng",
    "Pychowicka",
    "Referer",
    "rozhodnik",
    "Samesite",
    "tanstack",
    "tseslint",
    "turbopack",
    "voda",
    "Wasko",
    "webp",
    "wwwroot",
    "Xunit"
  ],
  "stylelint.validate": ["scss", "css"],
  "editor.codeActionsOnSave": {
    "source.fixAll.stylelint": "always"
  },
  "eslint.validate": ["javascript"],
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**.sln": true,
    "**/bin": true,
    "**/obj": true,
    "**/node_modules/**": true,
    "**/build/**": true
  },
  "lldb.displayFormat": "hex",
  "lldb.showDisassembly": "auto",
  "lldb.dereferencePointers": true,
  "lldb.consoleMode": "commands",

  "hide-files.files": ["next-env.d.ts", "yarn.lock", "node_modules", "build"],
  "todohighlight.keywords": [
    {
      "text": "SECT:",
      "isWholeLine": true,
      "backgroundColor": "#28242c"
    }
  ]
}
